# ==============================================================================
# RayzHub Environment Configuration Example
# All database operations pass through Blast Gateway (Render or Local)
# ==============================================================================

# BLAST Gateway Connection (Render or Local)
# Point this to your Render Blast Gateway: e.g. https://blast-gateway.onrender.com
BLAST_URL=http://127.0.0.1:8080
BLAST_KEY=blast-secret-key-1
ENABLE_BLAST_SYNC=true

# RayzHub Server Settings
HOST=0.0.0.0
PORT=8000
